pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        COMPOSE_PROJECT_NAME = 'docker-jenkins-pipeline'
        DEPLOY_ENV_FILE = '/var/lib/jenkins/docker-jenkins.env'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Configuration') {
            steps {
                sh '''
                    set -eu
                    test -r "$DEPLOY_ENV_FILE"
                    docker compose --env-file "$DEPLOY_ENV_FILE" config --quiet
                '''
            }
        }

        stage('Test Frontend') {
            steps {
                // Include the root package required by the frontend file:.. dependency.
                sh '''
                    set -eu
                    archive=$(mktemp)
                    trap 'rm -f "$archive"' EXIT
                    git archive --output="$archive" HEAD
                    docker run --rm -i --user "$(id -u):$(id -g)" \
                        -e HOME=/tmp -e npm_config_cache=/tmp/npm-cache \
                        node:22-alpine sh -c '
                            set -eu
                            mkdir /tmp/source
                            tar -x -C /tmp/source
                            cd /tmp/source/02_frontend
                            npm ci --include=dev
                            npm test -- --runInBand
                        ' < "$archive"
                '''
            }
        }

        stage('Build Frontend') {
            steps {
                sh 'docker compose --env-file "$DEPLOY_ENV_FILE" build frontend'
            }
        }

        stage('Deploy Frontend') {
            steps {
                // API must already be deployed; do not recreate API or MySQL here.
                sh 'docker compose --env-file "$DEPLOY_ENV_FILE" up -d --no-deps --wait --wait-timeout 180 frontend'
            }
        }

        stage('Check Frontend') {
            steps {
                sh '''
                    set -eu
                    port=$(docker compose --env-file "$DEPLOY_ENV_FILE" port frontend 3000 | awk -F: 'NR == 1 {print $NF}')
                    test -n "$port"
                    curl -4 -fsS --connect-timeout 3 --max-time 5 -o /dev/null "http://127.0.0.1:$port/"
                    curl -4 -fsS --connect-timeout 3 --max-time 5 "http://127.0.0.1:$port/api/attractions"
                '''
            }
        }
    }

    post {
        success {
            echo 'Frontend deployment passed.'
        }
        failure {
            sh 'docker compose --env-file "$DEPLOY_ENV_FILE" logs --tail=50 frontend api || true'
        }
    }
}
