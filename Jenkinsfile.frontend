pipeline {
    agent any

    tools {
        nodejs 'Node22'
    }

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        COMPOSE_PROJECT_NAME = 'docker-jenkins-pipeline'
        DEPLOY_ENV_FILE = '/var/lib/jenkins/docker-jenkins.env'
        FRONTEND_URL = 'http://127.0.0.1:3000'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Clean this job workspace and checkout code'
                deleteDir()
                checkout scm
            }
        }

        stage('Prepare Environment') {
            steps {
                echo 'Validate Compose using the shared environment file'
                sh 'docker compose --env-file "$DEPLOY_ENV_FILE" config --quiet'
            }
        }

        stage('Install Frontend Dependencies') {
            steps {
                dir('02_frontend') {
                    sh 'npm ci --include=dev'
                }
            }
        }

        stage('Test Frontend') {
            steps {
                dir('02_frontend') {
                    sh 'npm test -- --runInBand'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                echo 'Build the frontend Docker image'
                sh 'docker compose --env-file "$DEPLOY_ENV_FILE" build frontend'
            }
        }

        stage('Deploy Frontend') {
            steps {
                echo 'Update only frontend; API must already be running'
                sh 'docker compose --env-file "$DEPLOY_ENV_FILE" up -d --no-deps --wait --wait-timeout 180 frontend'
            }
        }

        stage('Check Frontend') {
            steps {
                echo 'Check the page and its API proxy'
                sh 'curl -4 -fsS --connect-timeout 3 --max-time 5 -o /dev/null "$FRONTEND_URL/"'
                sh 'curl -4 -fsS --connect-timeout 3 --max-time 5 "$FRONTEND_URL/api/attractions"'
            }
        }
    }

    post {
        success {
            echo 'Frontend deployment passed'
        }
        failure {
            echo 'Show frontend and API logs'
            sh 'docker compose --env-file "$DEPLOY_ENV_FILE" logs --tail=50 frontend api'
        }
    }
}
